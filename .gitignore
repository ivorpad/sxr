# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Local tooling caches
.pytest_cache/
.ruff_cache/
.konpy/

# Not published: evals and Claude Code artifacts
eval/
.claude/
/CLAUDE.md

# Session-local, never tracked
HANDOFF.md

# Not published: internal planning and consult notes
/PLAN.md
/docs/

# Audit trail: the documents and reproducers are tracked, the bulk is not.
# Snapshots, captured runs and whole-tree hash manifests are all regenerable
# from the scripts and the commits, and together they run to tens of megabytes.
audit/**/baseline*/
audit/**/evidence*/*
!audit/**/evidence*/README.md
audit/**/*.tar.gz
audit/**/*-after-sha256.txt
audit/**/pytest*.xml
