+    for flag in ("--budget", "--line-limit"):
+        assert run(corpus, "show", flag, "-1").exit_code == 2
+        never = run(corpus, "prompts", flag, "-1")
+        assert never.exit_code == 0
+        assert "chars]" not in never.stdout
