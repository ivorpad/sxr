+    result = run(corpus, "grep", NEEDLE, "--full", "--budget", "400")
+    assert result.exit_code == 0
+    assert len(data_rows(result.stdout)) == 12
+    assert all("ENDOFHIT" in row for row in data_rows(result.stdout))
